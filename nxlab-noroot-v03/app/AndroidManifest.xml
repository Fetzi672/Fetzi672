<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="fac.nxlab.noroot">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="FAC NX Lab Non-Root"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name="fac.nxlab.noroot.MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="fac.nxlab.noroot.ScanService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
